# Copy to `keystore.properties` (gitignored) to build signed release APKs locally.
# CI does not use this file — it reads the same values from repository secrets.
#
# Create the keystore first:
#   keytool -genkeypair -v -keystore hibana-release.jks -alias hibana \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks file up somewhere safe. If it is lost, no future build can
# update an already-installed Hibana — Android rejects updates signed by a
# different key, and the only remedy is uninstalling and losing local data.

storeFile=../hibana-release.jks
storePassword=CHANGE_ME
keyAlias=hibana
keyPassword=CHANGE_ME
