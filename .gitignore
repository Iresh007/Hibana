# Release signing. The key is the app's permanent identity — anyone holding it
# can ship updates that users' devices accept as genuine, so it never enters
# version control. CI gets it from repository secrets instead.
*.keystore
*.jks
/keystore.properties

# Large third-party reference sources (kept locally for adapter work, not committed)
/mihon-*.zip
/IReader-*.zip
/Manatan-*.zip

# Stray nested clone accidentally committed as an embedded git repo (gitlink).
# Ignored so it is never re-added as a submodule.
/Mihon_like/
